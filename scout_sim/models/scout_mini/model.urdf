<?xml version="1.0" encoding="utf-8"?>
<robot name="scout_mini" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="namespace" default="" />

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="60"/>
      <inertia ixx="2.28864" ixy="0" ixz="0" iyy="5.10398" iyz="0" izz="3.43147"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
      <geometry>
        <mesh filename="$(find scout_sim)/models/meshes/scout_mini_base_link2.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
      <geometry>
        <box size="0.5 0.3 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="wheel_name x y z rpy_x rpy_y rpy_z">
    <link name="${wheel_name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="3"/>
        <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.7171" iyz="0" izz="0.1361"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find scout_sim)/models/meshes/wheel.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.0775"/>
        </geometry>
      </collision>
    </link>
    <joint name="${wheel_name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${rpy_x} ${rpy_y} ${rpy_z}"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel wheel_name="front_left_wheel" x="0.231976" y="0.208252" z="-0.100998" rpy_x="-1.57" rpy_y="0" rpy_z="0"/>
  <xacro:wheel wheel_name="front_right_wheel" x="0.231976" y="-0.208252" z="-0.099998" rpy_x="1.57" rpy_y="0" rpy_z="0"/>
  <xacro:wheel wheel_name="rear_left_wheel" x="-0.231976" y="0.208252" z="-0.100998" rpy_x="-1.57" rpy_y="0" rpy_z="0"/>
  <xacro:wheel wheel_name="rear_right_wheel" x="-0.231976" y="-0.208252" z="-0.099998" rpy_x="1.57" rpy_y="0" rpy_z="0"/>

  <!-- Sensors -->
  <link name="lidar_link">
    <origin xyz="0 0 0.089" rpy="0 0 0"/>
    <visual>
      <geometry>
        <mesh filename="$(find scout_sim)/models/meshes/rplidar.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.089" rpy="0 0 0"/>
  </joint>

  <!-- <link name="camera_link">
    <origin xyz="-2 0 1" rpy="0 0.3 0"/>
    <inertial>
      <mass value="0"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-2 0 1" rpy="0 0.3 0"/>
  </joint> -->

  <!-- ROS 2 Control -->
  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <!-- Joint state publisher -->
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <ros>
        <namespace>$(arg namespace)</namespace>
      </ros>
      <parameters>$(find scout_sim)/config/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- kp spring constant, kd damping constant -->
  <!-- <gazebo reference="front_left_wheel">
